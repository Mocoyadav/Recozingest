# Server Port (optional, defaults to 3000 or platform provided PORT)
PORT=3000

# MongoDB Connection URI (REQUIRED)
# For Local Development:
# MONGO_URI=mongodb://127.0.0.1:27017/ricozingest
#
# For Production (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-domain>/ricozingest?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ricozingest

# JWT Secret Key for token generation and verification (REQUIRED)
JWT_SECRET=your_super_secret_jwt_key_here
